msgstr "救人为先"

msgid "choice.c01.choice-black-camp-plan.option.rescue-and-evidence.detail"
msgstr "主力护送证人，米蕾尔沿途保存关键模板。"

msgid "choice.c01.choice-black-camp-plan.option.rescue-and-evidence.consequence"
msgstr "证人数增加。"

msgid "choice.c01.choice-black-camp-plan.option.split-the-force.label"
msgstr "分兵取证"

msgid "choice.c01.choice-black-camp-plan.option.split-the-force.detail"
msgstr "同时搜索三处营帐，路线更长、信息更完整。"

msgid "choice.c01.choice-black-camp-plan.option.split-the-force.consequence"
msgstr "证据值增加。"

msgid "choice.c01.choice-white-river-priority.prompt"
msgstr "白河撤离优先保住什么？"

msgid "choice.c01.choice-white-river-priority.context"
msgstr "河道不允许所有人、重装备和粮食同时安全通过。"

msgid "choice.c01.choice-white-river-priority.option.people-first.label"
msgstr "人员优先"

