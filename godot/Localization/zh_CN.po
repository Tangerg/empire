msgstr "与凯恩共管"

msgid "choice.c01.choice-bell-tower-control.option.joint-control-with-cain.detail"
msgstr "凯恩及其军团作为临时友军进入战场。"

msgid "choice.c01.choice-bell-tower-control.option.joint-control-with-cain.consequence"
msgstr "凯恩关系 +2。"

msgid "choice.c01.choice-bell-tower-control.option.race-for-the-fragment.label"
msgstr "争夺碎片"

msgid "choice.c01.choice-bell-tower-control.option.race-for-the-fragment.detail"
msgstr "各自关闭机构，先完成者带走碎片。"

msgid "choice.c01.choice-bell-tower-control.option.race-for-the-fragment.consequence"
msgstr "王冠碎片 +1。"

