msgstr "把可用护卫全部配给难民与伤员。"

msgid "choice.c01.choice-white-river-priority.option.people-first.consequence"
msgstr "难民关系 +2。"

msgid "choice.c01.choice-white-river-priority.option.save-supplies.label"
msgstr "物资优先"

msgid "choice.c01.choice-white-river-priority.option.save-supplies.detail"
msgstr "保住决定后续恢复能力的粮车。"

msgid "choice.c01.choice-white-river-priority.option.save-supplies.consequence"
msgstr "战役补给 +3。"

msgid "choice.c01.choice-mercenary-contract.prompt"
msgstr "如何承认佣兵欠款？"

msgid "choice.c01.choice-mercenary-contract.context"
