<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Empire</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Empire.Core/**/*.cs;Empire.Core.Tests/**/*.cs" />
    <ProjectReference Include="Empire.Core/Empire.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <Compile Remove="Presentation/**/*Checks.cs;Presentation/NativeCapture.cs;Presentation/TerrainPreview.cs" />
  </ItemGroup>
</Project>
