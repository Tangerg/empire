<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EmpireCombatRoot Condition="'$(EmpireCombatRoot)' == ''">$(EmpireRoot)/godot/Empire.Core/Combat</EmpireCombatRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(EmpireRoot)/godot/Empire.Core/Errors.cs" />
    <Compile Include="$(EmpireRoot)/godot/Empire.Core/Registries/*.cs" />
    <Compile Include="$(EmpireRoot)/godot/Empire.Core/Determinism/*.cs" />
    <Compile Include="$(EmpireRoot)/godot/Empire.Core/State/StateJson.cs" />
    <Compile Include="$(EmpireRoot)/godot/Empire.Core/State/StateContent.cs" />
    <Compile Include="$(EmpireRoot)/godot/Empire.Core/State/ReadOnlyContent.cs" />
    <Compile Include="$(EmpireRoot)/godot/Empire.Core/Geometry/*.cs" />
    <Compile Include="$(EmpireRoot)/godot/Empire.Core/Tactics/*.cs" />
    <Compile Include="$(EmpireRoot)/godot/Empire.Core/Progression/FormationRules.cs" />
    <Compile Include="$(EmpireRoot)/godot/Empire.Core/Resources/*.cs" />
    <Compile Include="$(EmpireCombatRoot)/*.cs" />
    <Compile Include="$(EmpireRoot)/godot/Empire.Core/Lifecycle/ILifecycleEffects.cs" />
  <Compile Include="$(EmpireRoot)/godot/Empire.Core/Statuses/StatusTransitions.cs" />
<Compile Include="$(EmpireRoot)/godot/Empire.Core/Progression/RankProgressionPolicy.cs" />
<Compile Include="$(EmpireRoot)/godot/Empire.Core/Lifecycle/UnitDepartureHandlers.cs" />
</ItemGroup>
</Project>
