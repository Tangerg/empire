    <Compile Include="../../../godot/Presentation/Feedback/*.cs" Link="Feedback/%(Filename)%(Extension)" />
    <Compile Include="../../../godot/Localization/GameText.cs" Link="Localization/GameText.cs" />
    <Compile Include="../check-support/FixtureText.cs" Link="Checks/FixtureText.cs" />
