<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EmpireCombatRoot Condition="'$(EmpireCombatRoot)' == ''">$(EmpireRoot)/godot/Empire.Core/Combat</EmpireCombatRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs"/>
    <Compile Include="$(EmpireRoot)/godot/Empire.Core/**/*.cs" Exclude="$(EmpireRoot)/godot/Empire.Core/obj/**/*.cs;$(EmpireRoot)/godot/Empire.Core/bin/**/*.cs;$(EmpireRoot)/godot/Empire.Core/Combat/**/*.cs"/>
    <Compile Include="$(EmpireCombatRoot)/*.cs"/>
  </ItemGroup>
</Project>
