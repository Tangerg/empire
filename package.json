{
  "name": "empire-tactics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ancient Empires style turn-based tactics — headless TS core + SVG renderer + map editor",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
