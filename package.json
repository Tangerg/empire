{
  "name": "empire-srpg-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ancient Empires style turn-based tactics — headless TS core + SVG renderer + map editor",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @empire/game-app",
    "demo": "npm run dev --workspace @empire/engine-demo-app",
    "editor": "npm run dev --workspace @empire/editor-app",
    "experience": "npm run dev --workspace @empire/experience-lab-app",
    "build": "npm run typecheck && npm run build:apps",
    "build:apps": "npm run build --workspace @empire/game-app && npm run build --workspace @empire/editor-app && npm run build --workspace @empire/engine-demo-app && npm run build --workspace @empire/experience-lab-app",
    "build:experience": "npm run build --workspace @empire/experience-lab-app",
    "preview": "npm run preview --workspace @empire/game-app",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:core": "vitest bench --run packages/battle-engine/src/__bench__/engine.bench.ts",
    "sweep": "vite-node tools/replay-sweep.ts",
    "board:digest": "vite-node tools/board-digest.ts",
    "board:flat": "vite-node tools/board-flat.ts",
    "board:scale": "vite-node tools/board-scale.ts",
    "ui:shot": "vite-node tools/ui-shot.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^2.1.8"
  }
}
